MGPANEL_HTTP_ADDR=0.0.0.0:8080
MGPANEL_SHUTDOWN_TIMEOUT=15s

MGPANEL_LOG_LEVEL=info
MGPANEL_LOG_FORMAT=json
MGPANEL_LOG_ADD_SOURCE=false
MGPANEL_ENV=development

MGPANEL_DB_PATH=./data/mgpanel.db

MGPANEL_AUTH_SIGNING_KEY=change-me
MGPANEL_AUTH_TOKEN_TTL=24h
MGPANEL_AUTH_ISSUER=mgpanel
MGPANEL_AUTH_AUDIENCE=mgpanel-client
MGPANEL_AUTH_LEEWAY=30s
MGPANEL_AUTH_BCRYPT_COST=12

MGPANEL_ADMIN_UI_ENABLED=true
MGPANEL_ADMIN_UI_DIR=web/admin
MGPANEL_ADMIN_UI_TITLE=MGPanel Admin
MGPANEL_ADMIN_UI_VERSION=go-dev
MGPANEL_ADMIN_UI_LOGO=https://mgpanel.io/images/logo.png
# leave empty to auto-detect request origin
MGPANEL_ADMIN_UI_BASE_URL=

MGPANEL_INSTALL_UI_ENABLED=true
MGPANEL_INSTALL_UI_DIR=web/install